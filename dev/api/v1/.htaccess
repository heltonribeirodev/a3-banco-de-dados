# Redireciona todas as rotas amigáveis (/produtos/3) para o index.php
RewriteEngine On
# Repassa o cabeçalho Authorization ao PHP (necessário no Apache/XAMPP)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
